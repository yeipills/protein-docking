{
  "name": "protein-docking-frontend",
  "version": "3.0.0",
  "description": "Next-gen protein docking frontend powered by Svelte 5 with runes and 2025 web technologies",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "wasm:build": "wasm-pack build --target web --out-dir ../static/wasm",
    "worker:build": "node scripts/build-workers.js"
  },
  "dependencies": {
    "@babylonjs/core": "^6.0.0",
    "@babylonjs/gui": "^6.0.0",
    "@babylonjs/inspector": "^6.0.0",
    "@babylonjs/loaders": "^6.0.0",
    "@babylonjs/materials": "^6.0.0",
    "@sveltejs/kit": "^2.5.0",
    "@tanstack/svelte-query": "^5.17.0",
    "@threlte/core": "^8.0.0",
    "@threlte/extras": "^9.0.0",
    "axios": "^1.7.0",
    "comlink": "^4.4.1",
    "fflate": "^0.8.2",
    "immer": "^10.0.3",
    "svelte": "^5.0.0",
    "three": "^0.170.0",
    "three-stdlib": "^2.30.0",
    "workbox-window": "^7.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.2.0",
    "@sveltejs/adapter-static": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^4.0.0-next.6",
    "@types/node": "^20.11.0",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/ui": "^2.0.0",
    "c8": "^10.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.35.0",
    "prettier": "^3.2.0",
    "prettier-plugin-svelte": "^3.2.0",
    "rollup-plugin-web-worker-loader": "^1.6.1",
    "svelte-check": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vitest": "^2.0.0",
    "wasm-pack": "^0.13.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "overrides": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0-next.6"
  }
}
