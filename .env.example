# ================================
# ENVIRONMENT CONFIGURATION
# ================================
ENVIRONMENT=development  # development, staging, production

# ================================
# DATABASE CONFIGURATION
# ================================
POSTGRES_USER=protein_user
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_DB=protein_docking
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ================================
# REDIS CONFIGURATION
# ================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ================================
# CELERY CONFIGURATION
# ================================
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# ================================
# BACKEND API CONFIGURATION
# ================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
BACKEND_WORKERS=4
BACKEND_RELOAD=true  # Set to false in production

# ================================
# SOCKET SERVER CONFIGURATION
# ================================
SOCKET_HOST=0.0.0.0
SOCKET_PORT=8080
SOCKET_SECRET_KEY=change_this_secret_key_in_production_minimum_32_chars

# ================================
# JWT AUTHENTICATION
# ================================
JWT_SECRET_KEY=change_this_jwt_secret_key_in_production_minimum_64_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ================================
# SECURITY
# ================================
# Development: Use localhost origins
# Production: Replace with your actual domain(s)
# Example production: https://your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost
CORS_ALLOW_CREDENTIALS=true
SECRET_KEY=change_this_secret_key_for_general_encryption

# ================================
# RATE LIMITING
# ================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
MAX_CONCURRENT_JOBS_PER_USER=3

# ================================
# FILE UPLOAD LIMITS
# ================================
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_UPLOAD=10
ALLOWED_FILE_EXTENSIONS=.stl,.vert,.face,.txt

# ================================
# PROTEIN PROCESSING CONFIGURATION
# ================================
PROCESSING_TIMEOUT_SECONDS=3600
CLEANUP_OLD_FILES_DAYS=7
CONTEXT_RAYS_RADIUS=3
CONTEXT_RAYS_DELTA=10

# ================================
# FRONTEND CONFIGURATION (Vite)
# ================================
# Development: Point to local services
# Production: Set to your domain with /api/v1 path (proxied through Nginx)
# Example production: VITE_API_URL=https://your-domain.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:8080
VITE_ENV=development

# ================================
# NGINX CONFIGURATION
# ================================
# Development: Use localhost
# Production: Set to your actual domain (e.g., your-domain.com)
NGINX_HOST=localhost
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ================================
# LOGGING
# ================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text
LOG_FILE=/app/logs/app.log

# ================================
# MONITORING (Optional)
# ================================
SENTRY_DSN=
PROMETHEUS_PORT=9090
