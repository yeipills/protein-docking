{
  "dashboard": {
    "id": null,
    "title": "🧬 Protein Docking v2 - Ultra Performance Dashboard",
    "tags": ["protein-docking", "performance", "bioinformatics"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "5s",
    "schemaVersion": 30,
    "version": 1,
    "description": "Dashboard ultra-optimizado para monitoreo en tiempo real de protein docking con métricas críticas de rendimiento",
    
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    
    "timepicker": {
      "refresh_intervals": ["1s", "5s", "10s", "30s", "1m", "5m"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },

    "templating": {
      "list": [
        {
          "name": "instance",
          "type": "query",
          "query": "label_values(up{job=\"protein-docking-backend\"}, instance)",
          "refresh": 1,
          "includeAll": true,
          "multi": true,
          "allValue": ".*"
        },
        {
          "name": "job_type",
          "type": "query", 
          "query": "label_values(protein_docking_jobs_total, job_type)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        }
      ]
    },

    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "changes(up{job=\"protein-docking-backend\"}[5m]) > 0",
          "iconColor": "blue",
          "titleFormat": "Deployment"
        },
        {
          "name": "Alerts",
          "datasource": "Prometheus", 
          "enable": true,
          "expr": "ALERTS{alertstate=\"firing\"}",
          "iconColor": "red",
          "titleFormat": "Alert: {{alertname}}"
        }
      ]
    },

    "panels": [
      {
        "id": 1,
        "title": "🚀 Docking Jobs Throughput",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 50},
                {"color": "green", "value": 100}
              ]
            },
            "unit": "jobs/sec",
            "decimals": 2
          }
        },
        "targets": [
          {
            "expr": "protein_docking:jobs_per_second",
            "legendFormat": "Jobs/sec",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background"
        }
      },

      {
        "id": 2,
        "title": "⚡ Average Computation Time",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 15}
              ]
            },
            "unit": "s",
            "decimals": 2
          }
        },
        "targets": [
          {
            "expr": "protein_docking:avg_computation_time_seconds",
            "legendFormat": "Avg Time",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "colorMode": "background"
        }
      },

      {
        "id": 3,
        "title": "🎯 Success Rate",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 90},
                {"color": "green", "value": 95}
              ]
            },
            "unit": "percent",
            "decimals": 1,
            "max": 100,
            "min": 0
          }
        },
        "targets": [
          {
            "expr": "protein_docking:success_rate",
            "legendFormat": "Success %",
            "refId": "A"
          }
        ]
      },

      {
        "id": 4,
        "title": "🔥 GPU Utilization",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "blue", "value": 0},
                {"color": "green", "value": 50},
                {"color": "yellow", "value": 80},
                {"color": "red", "value": 95}
              ]
            },
            "unit": "percent",
            "max": 100,
            "min": 0
          }
        },
        "targets": [
          {
            "expr": "protein_docking:gpu_utilization_avg",
            "legendFormat": "GPU %",
            "refId": "A"
          }
        ]
      },

      {
        "id": 5,
        "title": "📊 Jobs Performance Over Time",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 20,
              "gradientMode": "opacity",
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              },
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "pointSize": 4,
              "scaleDistribution": {"type": "linear"},
              "showPoints": "never",
              "spanNulls": true,
              "stacking": {"group": "A", "mode": "none"},
              "thresholdsStyle": {"mode": "off"}
            },
            "unit": "short"
          }
        },
        "targets": [
          {
            "expr": "rate(protein_docking_jobs_completed_total[1m])",
            "legendFormat": "Completed Jobs/sec",
            "refId": "A"
          },
          {
            "expr": "rate(protein_docking_jobs_failed_total[1m])",
            "legendFormat": "Failed Jobs/sec",
            "refId": "B"
          },
          {
            "expr": "protein_docking_jobs_active",
            "legendFormat": "Active Jobs",
            "refId": "C"
          }
        ],
        "options": {
          "legend": {
            "calcs": ["mean", "max"],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {"mode": "multi"}
        }
      },

      {
        "id": 6,
        "title": "💾 System Resources",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineWidth": 1,
              "pointSize": 3
            },
            "unit": "percent",
            "max": 100,
            "min": 0
          }
        },
        "targets": [
          {
            "expr": "protein_docking:cpu_utilization_avg",
            "legendFormat": "CPU %",
            "refId": "A"
          },
          {
            "expr": "protein_docking:memory_usage_percent",
            "legendFormat": "Memory %",
            "refId": "B"
          },
          {
            "expr": "protein_docking:gpu_utilization_avg",
            "legendFormat": "GPU %",
            "refId": "C"
          }
        ]
      },

      {
        "id": 7,
        "title": "🧠 Algorithm Performance",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "algorithms:simd_ops_per_second",
            "legendFormat": "SIMD Ops/sec",
            "refId": "A"
          },
          {
            "expr": "algorithms:spatial_search_time_ms",
            "legendFormat": "Spatial Search Time (ms)",
            "refId": "B"
          }
        ]
      },

      {
        "id": 8,
        "title": "🗄️ Cache Performance",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 8, "x": 8, "y": 12},
        "targets": [
          {
            "expr": "redis:cache_hit_rate",
            "legendFormat": "Redis Hit Rate %",
            "refId": "A"
          },
          {
            "expr": "rate(redis_commands_total[1m])",
            "legendFormat": "Redis Commands/sec",
            "refId": "B"
          }
        ]
      },

      {
        "id": 9,
        "title": "📈 Docking Score Distribution",
        "type": "histogram",
        "gridPos": {"h": 6, "w": 8, "x": 16, "y": 12},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, protein_docking_result_score_bucket)",
            "legendFormat": "95th percentile",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, protein_docking_result_score_bucket)",
            "legendFormat": "Median",
            "refId": "B"
          }
        ]
      },

      {
        "id": 10,
        "title": "🚨 Performance Alerts",
        "type": "alertlist",
        "gridPos": {"h": 4, "w": 12, "x": 0, "y": 18},
        "options": {
          "alertInstanceLabelFilter": "job=protein-docking-backend",
          "dashboardAlerts": false,
          "groupBy": ["alertname"],
          "groupMode": "default",
          "maxItems": 20,
          "sortOrder": 1,
          "stateFilter": {
            "error": true,
            "firing": true,
            "inactive": false,
            "pending": true
          }
        }
      },

      {
        "id": 11,
        "title": "📊 Top Protein Types by Usage",
        "type": "piechart",
        "gridPos": {"h": 4, "w": 12, "x": 12, "y": 18},
        "targets": [
          {
            "expr": "topk(10, sum by (protein_type) (rate(protein_docking_jobs_total[1h])))",
            "legendFormat": "{{protein_type}}",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "pieType": "pie",
          "tooltip": {"mode": "single"},
          "legend": {
            "displayMode": "list",
            "placement": "right"
          }
        }
      }
    ]
  },
  
  "overwrite": true,
  "folderId": 0,
  "folderUid": "",
  "message": "Ultra-optimized protein docking dashboard v2.0"
}