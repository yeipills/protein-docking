# Multi-stage GPU-enabled Dockerfile for Protein Docking Backend
# AGENTE 4: DevOps & Infrastructure Specialist
# Ultra-optimized with CUDA acceleration for molecular docking

# Stage 1: CUDA Development Environment
FROM nvidia/cuda:12.1-devel-ubuntu22.04 AS cuda-builder

# Metadata
LABEL maintainer="Protein Docking v2 Team"
LABEL description="GPU-accelerated protein docking backend"
LABEL gpu.required="true"

# Environment variables for CUDA
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV CUDA_VERSION=12.1
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

# Install system dependencies + CUDA development
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build essentials
    build-essential \
    cmake \
    pkg-config \
    curl \
    ca-certificates \
    git \
    # CUDA development
    cuda-toolkit-12-3 \
    cuda-nvml-dev-12-3 \
    libcudnn8-dev \
    # Math libraries with CUDA support
    libcublas-dev-12-3 \
    libcufft-dev-12-3 \
    libcurand-dev-12-3 \
    libcusolver-dev-12-3 \
    libcusparse-dev-12-3 \
    libthrust-dev \
    # Traditional math libraries
    libopenblas-dev \
    liblapack-dev \
    libeigen3-dev \
    # Parallel processing
    libtbb-dev \
    libnuma-dev \
    # Database connectivity
    libpq-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Rust with CUDA support
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH \
    RUST_VERSION=1.84.0

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain $RUST_VERSION && \
    chmod -R a+w $RUSTUP_HOME $CARGO_HOME

# Install CUDA-related Rust components
RUN rustup component add rust-src && \
    rustup target add nvptx64-nvidia-cuda

# Install Cargo tools for CUDA
RUN cargo install cargo-cuda

# Rust compilation flags for GPU optimization
ENV RUSTFLAGS="-C target-cpu=native -C opt-level=3 -C link-arg=-s -C codegen-units=1 -C lto=fat -C target-feature=+avx2,+fma"
ENV CUDA_ARCH_LIST="6.0 6.1 7.0 7.5 8.0 8.6 8.9 9.0"

# Set working directory
WORKDIR /app

# Copy Cargo files for dependency caching
COPY Cargo.toml Cargo.lock ./

# Create dummy main for dependency build
RUN mkdir src && echo "fn main() {}" > src/main.rs

# Build dependencies with GPU support
RUN cargo build --release --features gpu,cuda
RUN rm -f target/release/deps/protein_docking_backend*

# Copy source code
COPY src ./src

# Build application with GPU features
RUN cargo build --release --features gpu,cuda --bin server

# Stage 2: CUDA Runtime Environment
FROM nvidia/cuda:12.1-runtime-ubuntu22.04 AS cuda-runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Runtime libraries
    ca-certificates \
    libssl3 \
    libpq5 \
    # CUDA runtime libraries
    libcublas12 \
    libcufft12 \
    libcurand12 \
    libcusolver12 \
    libcusparse12 \
    libcudnn8 \
    # Math libraries
    libopenblas0 \
    liblapack3 \
    libtbb12 \
    # Monitoring tools
    nvidia-ml-py3 \
    && rm -rf /var/lib/apt/lists/*

# Create app user and directories
RUN groupadd -r app && useradd -r -g app app && \
    mkdir -p /app/{uploads,results,logs,gpu-cache} && \
    chown -R app:app /app

# Copy binary from builder
COPY --from=cuda-builder /app/target/release/server /usr/local/bin/protein-docking-server
RUN chmod +x /usr/local/bin/protein-docking-server

# GPU configuration
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV CUDA_DEVICE_ORDER=PCI_BUS_ID
ENV CUDA_CACHE_PATH=/app/gpu-cache

# Performance environment variables
ENV CUDA_LAUNCH_BLOCKING=0
ENV CUDA_DEVICE_MAX_CONNECTIONS=32
ENV GPU_MEMORY_POOL_SIZE=8GB
ENV GPU_MAX_CONCURRENT_KERNELS=64

# Application environment
ENV RUST_LOG=info
ENV TOKIO_WORKER_THREADS=16
ENV RAYON_NUM_THREADS=16

# Switch to app user
USER app
WORKDIR /app

# Expose port
EXPOSE 8080

# Health check with GPU validation
HEALTHCHECK --interval=30s --timeout=15s --start-period=60s --retries=3 \
    CMD protein-docking-server --health-check && nvidia-smi -q -d TEMPERATURE | grep "GPU Current Temp" || exit 1

# Run the application
CMD ["protein-docking-server"]

# Stage 3: Production with Multi-GPU support
FROM cuda-runtime AS production-multi-gpu

# Multi-GPU configuration
ENV NVIDIA_VISIBLE_DEVICES=all
ENV CUDA_VISIBLE_DEVICES=0,1,2,3
ENV GPU_MULTI_DEVICE=true
ENV NCCL_DEBUG=INFO

# Production optimizations
ENV PROTEIN_DOCKING_ENABLE_GPU=true
ENV PROTEIN_DOCKING_ENABLE_MULTI_GPU=true
ENV PROTEIN_DOCKING_GPU_BATCH_SIZE=1024
ENV PROTEIN_DOCKING_GPU_MEMORY_FRACTION=0.9

# NCCL configuration for multi-GPU
ENV NCCL_SOCKET_IFNAME=eth0
ENV NCCL_IB_DISABLE=1

# Production command
CMD ["protein-docking-server", "--production", "--multi-gpu"]

# Stage 4: Development with debugging tools
FROM cuda-builder AS development

# Install development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    # CUDA debugging and profiling
    cuda-gdb \
    cuda-memcheck \
    nsight-compute-2023.3.1 \
    nsight-systems-2023.4.4 \
    # System monitoring
    nvtop \
    htop \
    iotop \
    # Development tools
    gdb \
    valgrind \
    strace \
    && rm -rf /var/lib/apt/lists/*

# Development Rust tools
RUN cargo install cargo-expand cargo-udeps cargo-audit

# Development environment
ENV RUST_LOG=debug
ENV RUST_BACKTRACE=full
ENV CUDA_LAUNCH_BLOCKING=1
ENV NVTX_PROFILING=1

# Create development user
RUN groupadd -r dev && useradd -r -g dev dev && \
    usermod -aG app dev && \
    chown -R dev:dev /app

USER dev
WORKDIR /app

# Development command with hot reload
CMD ["cargo", "watch", "-x", "run --features gpu,cuda,debug"]

# Stage 5: Benchmarking and testing
FROM development AS benchmark

# Install benchmarking tools
RUN cargo install criterion cargo-bench

# Benchmarking environment
ENV PROTEIN_DOCKING_BENCHMARK_MODE=true
ENV CUDA_PROFILE=1

# Benchmark command
CMD ["cargo", "bench", "--features", "gpu,cuda,benchmark"]